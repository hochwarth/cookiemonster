<?php

declare(strict_types=1);

namespace ProcessWire;

class TextformatterCookieTable extends Textformatter implements Module
{
    /**
     * @return array<string, mixed>
     */
    public static function getModuleInfo(): array
    {
        return [
            'title' => 'CookieMonster Textformatter',
            'version' => 104,
            'summary' => 'Uses a shortcode to render a table with your configured cookies',
            'author' => 'Johannes Dachsel',
            'requires' => [
                'CookieMonster',
                'PHP>=8.2',
                'ProcessWire>=3.0.229',
            ],
        ];
    }

    /**
     * @param string $str
     */
    public function formatValue(Page $page, Field $field, &$str): void
    {
        $cmnstr = $this->modules->get('CookieMonster');

        if (!$cmnstr instanceof CookieMonster || !\is_string($str)) {
            return;
        }

        $shortcodes = [
            '[[cookie-table]]' => 'renderCookieTable',
            '[[cookie-list]]' => 'renderCookieList',
        ];

        foreach ($shortcodes as $shortcode => $method) {
            if (\str_contains($str, $shortcode)) {
                $str = \str_replace($shortcode, $cmnstr->$method(), $str);
            }
        }
    }
}
